---
/**
 * One multiple-choice question. Must sit inside <Quiz>, which wires the
 * click handling and the running score.
 *
 *   <MCQ q="Which command is O(N)?" options={["GET", "KEYS *", "INCR"]} answer={1}>
 *     Explanation in **markdown** — leave a blank line after the opening tag.
 *   </MCQ>
 *
 * `answer` is the zero-based index into `options`. `backtick` spans in
 * `q` and in options render as inline code.
 */
import { mcqId } from '~/lib/content-extract';

interface Props {
  q: string;
  options: string[];
  answer: number;
}
const { q, options, answer } = Astro.props;

// The mistakes notebook tracks questions by id. Only notes have a Quiz
// index (/review/mcqs.json), so anything else — or a page that didn't set
// `Astro.locals.entry` — renders without tracking.
const entry = Astro.locals.entry;
const note = entry && entry.collection === 'notes' ? entry : null;

if (answer < 0 || answer >= options.length) {
  throw new Error(`MCQ "${q}": answer index ${answer} out of range`);
}

// Split on backticks: odd-indexed parts were inside `…`.
const inline = (s: string) => s.split('`').map((text, i) => ({ text, code: i % 2 === 1 }));
const letters = 'ABCDEFGH';
---
<fieldset
  class="mcq"
  data-mcq
  data-answer={answer}
  data-mcq-id={note ? mcqId(note.id, q) : undefined}
  data-note-slug={note?.id}
  data-note-title={note?.data.title}
>
  <legend class="mcq__q">
    {inline(q).map((p) => (p.code ? <code>{p.text}</code> : p.text))}
  </legend>
  <div class="mcq__opts">
    {options.map((opt, i) => (
      <button type="button" class="mcq__opt" data-idx={i}>
        <span class="mcq__letter">{letters[i]}</span>
        <span>{inline(opt).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</span>
      </button>
    ))}
  </div>
  <div class="mcq__why" hidden>
    <p class="mcq__verdict" data-mcq-verdict role="status"></p>
    <p class="mcq__saved" data-mcq-saved hidden></p>
    <slot />
  </div>
</fieldset>

<style>
  .mcq {
    border: 1px solid var(--card-border);
    border-radius: 10px;
    background: var(--card-bg);
    margin: 0.8rem 0;
    padding: 0.9rem 1rem;
    min-width: 0;
  }
  .mcq__q { font-weight: 600; line-height: 1.45; padding: 0 0.2rem; float: left; width: 100%; margin-bottom: 0.7rem; }
  .mcq__opts { clear: both; display: grid; gap: 0.45rem; }
  .mcq__opt {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    text-align: left;
    font: inherit;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 0.55rem 0.75rem;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .mcq__opt:hover:not(:disabled) { border-color: var(--accent); }
  .mcq__opt:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mcq__opt:disabled { cursor: default; }
  .mcq__letter { font-family: var(--font-code); font-size: 0.8rem; color: var(--fg-muted); flex-shrink: 0; }
  .mcq__opt[data-state='correct'] {
    border-color: var(--anim-success);
    background: color-mix(in srgb, var(--anim-success) 14%, transparent);
  }
  .mcq__opt[data-state='wrong'] {
    border-color: var(--anim-danger);
    background: color-mix(in srgb, var(--anim-danger) 14%, transparent);
  }
  .mcq__opt[data-state='dim'] { opacity: 0.6; }
  .mcq__opt[data-tag]::after {
    content: attr(data-tag);
    margin-left: auto;
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .mcq__opt[data-state='correct']::after { color: var(--anim-success); }
  .mcq__opt[data-state='wrong']::after { color: var(--anim-danger); }
  .mcq__verdict { font-weight: 700; }
  .mcq__verdict[data-ok='true'] { color: var(--anim-success); }
  .mcq__verdict[data-ok='false'] { color: var(--anim-danger); }
  .mcq__saved { margin: -0.4rem 0 0.8rem; font-size: 0.8rem; color: var(--fg-muted); }
  .mcq__saved :global(a) { color: var(--primary-light); }
  .mcq__why {
    margin-top: 0.8rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--card-border);
  }
  .mcq__why > :global(:first-child) { margin-top: 0; }
  .mcq__why > :global(:last-child) { margin-bottom: 0; }
</style>
