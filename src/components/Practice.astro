---
/**
 * Wraps a run of <QA> blocks with a "Reveal all / Hide all" control.
 *
 *   ## Practice questions
 *   <Practice>
 *   <QA q="…" level="easy">…</QA>
 *   </Practice>
 */
---
<div class="practice" data-practice>
  <div class="practice__bar">
    <span class="practice__hint">Try answering out loud first, then reveal.</span>
    <button type="button" class="practice__all" data-practice-toggle aria-pressed="false">
      Reveal all
    </button>
  </div>
  <slot />
</div>

<script>
  function wire(root: Element) {
    const btn = root.querySelector<HTMLButtonElement>('[data-practice-toggle]');
    if (!btn || btn.dataset.wired) return;
    btn.dataset.wired = '1';
    const items = () => Array.from(root.querySelectorAll<HTMLDetailsElement>('details.qa'));
    const sync = () => {
      const allOpen = items().length > 0 && items().every((d) => d.open);
      btn.textContent = allOpen ? 'Hide all' : 'Reveal all';
      btn.setAttribute('aria-pressed', String(allOpen));
    };
    btn.addEventListener('click', () => {
      const open = !items().every((d) => d.open);
      items().forEach((d) => (d.open = open));
      sync();
    });
    items().forEach((d) => d.addEventListener('toggle', sync));
  }
  document.querySelectorAll('[data-practice]').forEach(wire);
</script>

<style>
  .practice { margin: 1rem 0 2rem; }
  .practice__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .practice__hint { color: var(--fg-muted); font-size: 0.85rem; font-style: italic; }
  .practice__all {
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--primary-light);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    border: 1px solid var(--card-border);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    cursor: pointer;
  }
  .practice__all:hover { border-color: var(--accent); }
  .practice__all:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
