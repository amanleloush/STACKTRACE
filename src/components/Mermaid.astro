---
// Drop-in Mermaid renderer. Include once on any page whose content may
// carry ```mermaid fences (note/DSA pages via NoteLayout, revision
// sheets via RevisePhase). The script is tiny; the mermaid package
// itself is only fetched when the page actually has a diagram — see
// src/lib/mermaid-render.ts.
---
<script>
  import { initMermaid } from '~/lib/mermaid-render';
  initMermaid();
</script>

<style is:global>
  .mmd {
    margin: 1.5rem 0;
    min-width: 0;
    max-width: 100%;
  }
  .mmd__canvas {
    /* Wide diagrams scroll here, never the page. */
    overflow-x: auto;
    overflow-y: hidden;
    max-width: 100%;
    padding: 1rem;
    background: var(--bg-soft);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    -webkit-overflow-scrolling: touch;
  }
  .mmd__canvas:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .mmd__canvas > svg {
    display: block;
    max-width: none;
    height: auto;
    margin: 0 auto;
  }
  .mmd__src {
    margin-top: 0.4rem;
    font-size: 0.85rem;
  }
  .mmd__src > summary {
    cursor: pointer;
    color: var(--fg-muted);
    width: fit-content;
  }
  .mmd__src > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .mmd__src > pre {
    margin: 0.5rem 0 0;
    overflow-x: auto;
  }
</style>
