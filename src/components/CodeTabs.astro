---
/**
 * Solution code in C++ / Java / Python tabs, each with a "Run in online
 * compiler" link to Compiler Explorer (godbolt.org).
 *
 * Authoring (in a DSA .mdx page; the component is registered in
 * src/pages/learn/dsa/[slug].astro). Put fenced blocks, and nothing else,
 * inside <CodeTabs>, with blank lines around each block:
 *
 *   <CodeTabs>
 *
 *   ```cpp
 *   class Solution { ... };          ← shown on the page
 *   ```
 *
 *   ```cpp driver
 *   #include <iostream>              ← hidden behind "Show full program",
 *   using namespace std;               sent to the compiler
 *
 *   // @solution                     ← the solution block is spliced in here
 *
 *   int main() { ... }
 *   ```
 *
 *   ```java
 *   class Solution { ... }
 *   ```
 *
 *   ```java driver
 *   import java.util.*;
 *   // @solution
 *   public class Main { public static void main(String[] args) { ... } }
 *   ```
 *
 *   ```python
 *   def solve(...): ...
 *   ```
 *
 *   ```python driver
 *   # @solution
 *   print(solve(...))
 *   ```
 *
 *   </CodeTabs>
 *
 * Rules:
 * - Languages: `cpp` (or c++), `java`, `python` (or py). Tabs always show
 *   in the order C++, Java, Python; C++ is the default. Any subset works.
 * - One solution block per language, plus an optional block with the meta
 *   word `driver`. The driver's `// @solution` (`# @solution` in Python)
 *   line is replaced by the solution; with no marker the solution goes
 *   first. Without a driver there is no "Show full program" and the run
 *   link sends the solution alone.
 * - src/lib/remark-code-tabs.ts does the grouping at build time and fails
 *   the build on anything else (stray prose, unknown language, duplicates).
 *   The full spec for converting pages is convert-dsa-spec.md.
 *
 * Behaviour: ARIA tabs with arrow / Home / End keys. The chosen language is
 * remembered site-wide in localStorage and applied to every CodeTabs on the
 * page. Without JavaScript all languages are shown stacked, each labelled.
 * Copy copies what is visible (the full program when it is expanded).
 */
import { DEFAULT_LANG, LANG_STORAGE_KEY, parseTabsProp } from '~/lib/code-tabs';

interface Props {
  /** JSON written by the remark plugin; not meant to be hand-authored. */
  tabs?: string;
  /** Unique per page; written by the remark plugin. */
  uid?: string;
}

const { tabs: rawTabs, uid = 'ct' } = Astro.props;
const tabs = parseTabsProp(rawTabs);
const panels = await Promise.all(
  tabs.map(async (t) => ({
    ...t,
    solutionHtml: Astro.slots.has(t.lang) ? await Astro.slots.render(t.lang) : '',
    fullHtml:
      t.hasDriver && Astro.slots.has(`${t.lang}-full`)
        ? await Astro.slots.render(`${t.lang}-full`)
        : '',
  })),
);
const initial = tabs.some((t) => t.lang === DEFAULT_LANG) ? DEFAULT_LANG : tabs[0]?.lang;
---
{panels.length > 0 && (
  <div class="ct" data-code-tabs data-storage-key={LANG_STORAGE_KEY}>
    <div class="ct__tablist" role="tablist" aria-label="Solution language" hidden data-ct-tablist>
      {panels.map((p) => (
        <button
          type="button"
          role="tab"
          class="ct__tab"
          id={`${uid}-tab-${p.lang}`}
          aria-controls={`${uid}-panel-${p.lang}`}
          aria-selected={p.lang === initial ? 'true' : 'false'}
          tabindex={p.lang === initial ? 0 : -1}
          data-lang={p.lang}
        >
          {p.label}
        </button>
      ))}
    </div>
    {panels.map((p) => (
      <div
        class="ct__panel"
        role="tabpanel"
        id={`${uid}-panel-${p.lang}`}
        aria-labelledby={`${uid}-tab-${p.lang}`}
        data-lang={p.lang}
      >
        <div class="ct__bar">
          <span class="ct__label">{p.label}</span>
          <span class="ct__actions">
            <button type="button" class="ct__btn" data-ct-copy hidden>Copy</button>
            {p.runUrl && (
              <a
                class="ct__btn ct__run"
                href={p.runUrl}
                target="_blank"
                rel="noopener noreferrer"
                title="Opens Compiler Explorer in a new tab. Your code is sent to godbolt.org."
              >
                Run in online compiler<span class="ct__sr"> (opens godbolt.org in a new tab)</span>
              </a>
            )}
          </span>
        </div>
        <div class="ct__code" data-ct-solution set:html={p.solutionHtml} />
        {p.fullHtml && (
          <details class="ct__full" data-ct-full>
            <summary>Show full program</summary>
            <div class="ct__code" set:html={p.fullHtml} />
          </details>
        )}
      </div>
    ))}
    <p class="ct__note">
      "Run" opens <a href="https://godbolt.org/" target="_blank" rel="noopener noreferrer">Compiler Explorer</a>
      with the full program; the code is sent to godbolt.org only when you click it.
    </p>
  </div>
)}

<script>
  import { isTabLang, LANG_STORAGE_KEY, type TabLang } from '~/lib/code-tabs';

  function readLang(): TabLang | null {
    try {
      const v = localStorage.getItem(LANG_STORAGE_KEY);
      return isTabLang(v) ? v : null;
    } catch {
      return null;
    }
  }
  function saveLang(lang: TabLang) {
    try {
      localStorage.setItem(LANG_STORAGE_KEY, lang);
    } catch {
      /* storage blocked: the choice lasts for this page only */
    }
  }

  const roots = () => Array.from(document.querySelectorAll<HTMLElement>('[data-code-tabs]'));
  const tabsOf = (root: HTMLElement) =>
    Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

  /** Select `lang` in one widget; false if it has no such tab. */
  function select(root: HTMLElement, lang: string, focus = false): boolean {
    const tabs = tabsOf(root);
    if (!tabs.some((t) => t.dataset.lang === lang)) return false;
    for (const t of tabs) {
      const on = t.dataset.lang === lang;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    }
    root.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((p) => {
      p.hidden = p.dataset.lang !== lang;
    });
    return true;
  }

  /** Apply a choice to every widget on the page (and remember it). */
  function selectEverywhere(lang: TabLang, from?: HTMLElement) {
    saveLang(lang);
    for (const r of roots()) select(r, lang, r === from);
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  function wire(root: HTMLElement) {
    if (root.dataset.wired) return;
    root.dataset.wired = '1';
    root.classList.add('ct--js');
    const list = root.querySelector<HTMLElement>('[data-ct-tablist]');
    if (list) list.hidden = false;

    const tabs = tabsOf(root);
    const initial = tabs.find((t) => t.getAttribute('aria-selected') === 'true')?.dataset.lang;
    const saved = readLang();
    if (!(saved && select(root, saved)) && initial) select(root, initial);

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const lang = tab.dataset.lang;
        if (isTabLang(lang)) selectEverywhere(lang, root);
      });
      tab.addEventListener('keydown', (e) => {
        const i = tabs.indexOf(tab);
        let next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        const lang = tabs[next]?.dataset.lang;
        if (isTabLang(lang)) selectEverywhere(lang, root);
      });
    }

    root.querySelectorAll<HTMLButtonElement>('[data-ct-copy]').forEach((btn) => {
      btn.hidden = !('clipboard' in navigator);
      btn.addEventListener('click', async () => {
        const panel = btn.closest<HTMLElement>('[role="tabpanel"]');
        const full = panel?.querySelector<HTMLDetailsElement>('[data-ct-full]');
        const box = full?.open ? full : panel?.querySelector('[data-ct-solution]');
        const text = box?.querySelector('pre')?.textContent ?? '';
        const ok = text !== '' && (await copyText(text));
        btn.textContent = ok ? 'Copied' : 'Copy failed';
        setTimeout(() => (btn.textContent = 'Copy'), 1500);
      });
    });
  }

  roots().forEach(wire);

  // Another browser tab changed the language: follow it.
  window.addEventListener('storage', (e) => {
    if (e.key === LANG_STORAGE_KEY && isTabLang(e.newValue)) {
      for (const r of roots()) select(r, e.newValue);
    }
  });
</script>

<style>
  .ct {
    margin: 1rem 0 1.5rem;
    min-width: 0;
  }
  .ct__tablist {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--card-border);
  }
  .ct__tablist[hidden] { display: none; }
  .ct__tab {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg-muted);
    background: transparent;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 0.4rem 0.9rem;
    margin-bottom: -1px;
    cursor: pointer;
  }
  .ct__tab:hover { color: var(--fg); }
  .ct__tab[aria-selected='true'] {
    color: var(--primary-light);
    background: var(--card-bg);
    border-color: var(--card-border);
    border-bottom: 1px solid var(--card-bg);
  }
  .ct__tab:focus-visible,
  .ct__btn:focus-visible,
  .ct__full summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* No JS: every panel shows, stacked, each under its own label. */
  .ct__panel {
    border: 1px solid var(--card-border);
    border-radius: 8px;
    background: var(--card-bg);
    padding: 0.5rem 0.75rem 0.25rem;
    margin-bottom: 0.75rem;
    min-width: 0;
  }
  .ct--js .ct__panel {
    border-top-left-radius: 0;
    border-top: none;
    margin-bottom: 0;
  }
  .ct__panel[hidden] { display: none; }

  .ct__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-bottom: 0.25rem;
  }
  .ct__label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  /* The tab already names the language once JS is on. */
  .ct--js .ct__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .ct__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-left: auto;
  }
  .ct__btn {
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--primary-light);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    border: 1px solid var(--card-border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
  }
  .ct__btn:hover { border-color: var(--primary-light); }
  .ct__btn[hidden] { display: none; }

  .ct__code { min-width: 0; }
  .ct__code :global(pre) {
    margin: 0.25rem 0 0.5rem;
    overflow-x: auto;
    max-width: 100%;
  }
  .ct__full {
    margin: 0 0 0.5rem;
  }
  .ct__full summary {
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--fg-muted);
    padding: 0.15rem 0;
  }
  .ct__full summary:hover { color: var(--fg); }

  .ct__note {
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
  .ct__note a { color: inherit; }
  .ct__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
