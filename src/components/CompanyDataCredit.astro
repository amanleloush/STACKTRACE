---
/**
 * Attribution + sync-status strip for the company-wise DSA section. The
 * dataset comes from liquidslr/leetcode-company-wise-problems (no license
 * file), so the section is free for everyone and every page credits it.
 */
import { SOURCE } from '~/lib/company-data';

const committed = new Date(SOURCE.committedAt);
const asOf = Number.isNaN(committed.getTime())
  ? ''
  : committed.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<p class="cd-credit">
  <span>
    Question lists from
    <a href={SOURCE.url} target="_blank" rel="noopener noreferrer">{SOURCE.repo}</a>
    {asOf && <span class="cd-credit__asof"> · snapshot {asOf}</span>}
    · free for everyone.
  </span>
  <span class="cd-sync" data-state="local" aria-live="polite">Progress saved in this browser</span>
</p>

<script>
  import { initProblemStore, onSyncState, type SyncState } from '~/lib/problem-store';

  const LABELS: Record<SyncState, string> = {
    local: 'Progress saved in this browser · sign in to sync',
    syncing: 'Syncing…',
    synced: 'Synced to your account',
    error: 'Saved locally · sync will retry next visit',
  };

  initProblemStore();
  for (const el of document.querySelectorAll<HTMLElement>('.cd-sync')) {
    onSyncState((s) => {
      el.dataset.state = s;
      el.textContent = LABELS[s];
    });
  }
</script>

<style>
  .cd-credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    color: var(--fg-faint);
  }
  .cd-credit a { color: var(--fg-muted); }
  .cd-sync { font-family: var(--font-code); font-size: 0.72rem; }
  .cd-sync[data-state='synced'] { color: var(--anim-success); }
  .cd-sync[data-state='error'] { color: var(--anim-highlight); }
</style>
