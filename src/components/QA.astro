---
/**
 * One practice question with a hidden answer. Native <details>, so it
 * toggles with no JS, stays keyboard-accessible, and the answer text is
 * still in the DOM for Pagefind to index.
 *
 *   <QA q="Why does Kafka use partitions?" level="easy">
 *     Answer in **markdown** — leave a blank line after the opening tag.
 *   </QA>
 *
 * `q` is a plain string; `backtick` spans in it render as inline code.
 */
interface Props {
  q: string;
  level?: 'easy' | 'medium' | 'hard' | 'scenario';
}
const { q, level } = Astro.props;

// Split on backticks: odd-indexed parts were inside `…`.
const parts = q.split('`').map((text, i) => ({ text, code: i % 2 === 1 }));
---
<details class="qa">
  <summary class="qa__head">
    {level && <span class={`qa__level qa__level--${level}`}>{level}</span>}
    <span class="qa__q">
      {parts.map((p) => (p.code ? <code>{p.text}</code> : p.text))}
    </span>
    <span class="qa__toggle" aria-hidden="true"></span>
  </summary>
  <div class="qa__a">
    <slot />
  </div>
</details>

<style>
  .qa {
    border: 1px solid var(--card-border);
    border-radius: 10px;
    background: var(--card-bg);
    margin: 0.6rem 0;
    transition: border-color 0.15s ease;
  }
  .qa[open] { border-color: var(--accent); }
  .qa__head {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    padding: 0.8rem 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    line-height: 1.45;
  }
  .qa__head::-webkit-details-marker { display: none; }
  .qa__head:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 10px; }
  .qa__q { flex: 1; }
  .qa__level {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    position: relative;
    top: -0.1em;
  }
  .qa__level--easy { color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .qa__level--medium { color: var(--primary-light); background: color-mix(in srgb, var(--primary) 16%, transparent); }
  .qa__level--hard { color: #fb7185; background: color-mix(in srgb, #fb7185 14%, transparent); }
  .qa__level--scenario { color: #f59e0b; background: color-mix(in srgb, #f59e0b 14%, transparent); }
  .qa__toggle {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .qa__toggle::before { content: 'Show answer ▾'; }
  .qa[open] .qa__toggle::before { content: 'Hide ▴'; }
  .qa__a {
    padding: 0 1rem 0.9rem;
    border-top: 1px dashed var(--card-border);
  }
  .qa__a > :global(:first-child) { margin-top: 0.8rem; }
  .qa__a > :global(:last-child) { margin-bottom: 0; }

  @media (max-width: 560px) {
    .qa__head { flex-wrap: wrap; }
    .qa__toggle { width: 100%; text-align: right; }
  }
</style>
