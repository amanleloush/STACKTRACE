---
// Offline fallback. Prerendered and precached by public/sw.js, which serves
// it for any navigation that fails while the network is down and has no
// cached copy. The script lists the pages this browser has saved, read
// straight from Cache Storage (same origin, so no worker round trip).
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Offline — StackTrace"
  description="You're offline. Pages you've opened and revision sheets you saved still work."
>
  <section class="off">
    <h1>You're offline</h1>
    <p class="off__lede">
      This page isn't saved on this device yet. Pages you've already opened, and revision sheets
      you saved from the <a href="/revise/">Revise</a> hub, still work without a connection.
    </p>
    <p class="off__actions">
      <button type="button" class="off__btn" id="off-retry">Try again</button>
      <a class="off__btn off__btn--ghost" href="/revise/">Revision sheets</a>
    </p>

    <div id="off-saved" hidden>
      <h2 class="off__h2">Saved on this device</h2>
      <ul class="off__list" id="off-list"></ul>
    </div>
  </section>
</BaseLayout>

<script>
  document.getElementById('off-retry')?.addEventListener('click', () => window.location.reload());

  type Saved = { path: string; label: string; group: string };

  function describe(path: string): Saved | null {
    const parts = path.split('/').filter(Boolean);
    const pretty = (s: string): string =>
      s.replace(/^\d+-/, '').replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase());
    if (parts[0] === 'revise' && parts.length === 1) return { path, label: 'Revision hub', group: 'Revision' };
    if (parts[0] === 'revise' && parts.length === 3) {
      return { path, label: `${parts[1] === 'dsa' ? 'DSA' : 'System design'}: ${pretty(parts[2])}`, group: 'Revision' };
    }
    if (parts[0] === 'learn' && parts.length === 3) {
      return { path, label: pretty(parts[2]), group: parts[1] === 'dsa' ? 'DSA' : 'System design' };
    }
    return null;
  }

  async function listSaved(): Promise<void> {
    if (!('caches' in window)) return;
    const seen = new Set<string>();
    const items: Saved[] = [];
    try {
      for (const name of await caches.keys()) {
        if (!/^stacktrace-(pages|shell)-/.test(name)) continue;
        const cache = await caches.open(name);
        for (const req of await cache.keys()) {
          const path = new URL(req.url).pathname;
          if (seen.has(path)) continue;
          seen.add(path);
          const d = describe(path);
          if (d) items.push(d);
        }
      }
    } catch {
      return; // storage blocked: the static text above still helps
    }
    if (items.length === 0) return;
    items.sort((a, b) => a.group.localeCompare(b.group) || a.label.localeCompare(b.label));
    const list = document.getElementById('off-list');
    if (!list) return;
    for (const it of items) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = it.path;
      a.textContent = it.label;
      const tag = document.createElement('span');
      tag.className = 'off__tag';
      tag.textContent = it.group;
      li.append(tag, a);
      list.appendChild(li);
    }
    document.getElementById('off-saved')?.removeAttribute('hidden');
  }
  void listSaved();
</script>

<style>
  .off { max-width: 640px; margin: 2rem auto; text-align: center; }
  .off h1 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 800;
    background: var(--grad-3);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .off__lede { color: var(--fg); line-height: 1.55; margin: 0.8rem auto 0; max-width: 56ch; }
  .off__actions {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
    margin: 1.4rem 0 0;
  }
  .off__btn {
    font: inherit;
    font-weight: 600;
    padding: 0.5rem 1.1rem;
    border-radius: 10px;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
    text-decoration: none;
  }
  .off__btn--ghost { background: transparent; color: var(--fg); border-color: var(--card-border); }
  .off__btn:hover { text-decoration: none; filter: brightness(1.08); }
  .off__btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .off__h2 { font-size: 1.05rem; margin: 2.2rem 0 0.8rem; }
  .off__list {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: left;
    display: grid;
    gap: 0.4rem;
  }
  .off__list :global(li) {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    background: var(--card-bg);
    min-width: 0;
  }
  .off__list :global(a) { overflow-wrap: anywhere; }
  /* List items are created by the script, so they carry no scoped attribute. */
  .off__list :global(.off__tag) {
    flex: none;
    font-family: var(--font-code);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-faint);
  }
</style>
