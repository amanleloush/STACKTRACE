---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CompanyDataCredit from '~/components/CompanyDataCredit.astro';
import { COMPANIES_INDEX, PROBLEMS } from '~/lib/company-data';

const { companies, topN, minProblems } = COMPANIES_INDEX;
const uniqueProblems = Object.keys(PROBLEMS).length;
const pct = (n: number, d: number): string => `${d ? (n / d) * 100 : 0}%`;
---
<BaseLayout
  title="Company-wise DSA questions — StackTrace"
  description={`LeetCode problems asked at ${companies.length} companies, ranked by frequency. Track what you've solved and keep notes — free.`}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/dsa/">DSA</a> <span aria-hidden="true">/</span> <span aria-current="page">Companies</span>
  </nav>

  <header class="co-head">
    <h1>Company-wise questions</h1>
    <p class="co-lede">
      The top {topN} LeetCode problems each company asks, ranked by how often they come up.
      {companies.length} companies · {uniqueProblems.toLocaleString('en-US')} unique problems.
      Tick a problem once and it's solved on <em>every</em> list that has it; your notes follow it too.
    </p>
    <p class="co-links">
      <a href="/dsa/my-notes/">My notes &amp; solved problems →</a>
    </p>
    <CompanyDataCredit />
  </header>

  <section class="co-filters" aria-label="Filter companies">
    <input class="co-f co-f--search" type="search" placeholder="Search companies…" aria-label="Search companies" />
    <select class="co-f co-f--sort" aria-label="Sort companies">
      <option value="size">Most questions</option>
      <option value="name">A → Z</option>
      <option value="recent">Most recent activity</option>
      <option value="solved">Most solved by me</option>
    </select>
    <label class="co-f co-f--check">
      <input type="checkbox" class="co-f--started" /> Started only
    </label>
    <span class="co-count" aria-live="polite"><span class="co-count__n">{companies.length}</span> companies</span>
  </section>

  <ul class="co-grid">
    {companies.map((c, i) => (
      <li
        class="co-card"
        data-slug={c.slug}
        data-name={c.name.toLowerCase()}
        data-order={i}
        data-recent={c.recent}
        data-total={c.problemCount}
      >
        <a class="co-card__link" href={`/dsa/companies/${c.slug}/`}>
          <h2 class="co-card__name">{c.name}</h2>
          <p class="co-card__meta">
            {c.problemCount} questions
            {c.recent > 0 && <span class="co-card__recent" title="Reported in the last six months"> · {c.recent} recent</span>}
          </p>
          <div class="co-split" aria-label={`${c.easy} easy, ${c.medium} medium, ${c.hard} hard`}>
            <span class="co-split__e" style={`width:${pct(c.easy, c.problemCount)}`}></span>
            <span class="co-split__m" style={`width:${pct(c.medium, c.problemCount)}`}></span>
            <span class="co-split__h" style={`width:${pct(c.hard, c.problemCount)}`}></span>
          </div>
          <p class="co-card__legend">
            <span class="co-dot co-dot--e"></span>{c.easy} Easy
            <span class="co-dot co-dot--m"></span>{c.medium} Med
            <span class="co-dot co-dot--h"></span>{c.hard} Hard
          </p>
          <div class="co-solved">
            <span class="co-solved__bar"><span class="co-solved__fill"></span></span>
            <span class="co-solved__text"><span class="co-solved__n">0</span> / {c.problemCount} solved</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
  <p class="co-empty" hidden>No companies match.</p>

  <p class="co-foot">
    Showing companies with at least {minProblems} reported problems. Frequency and "recent" windows
    (last 30 days / 3 months / 6 months) come from the source dataset.
  </p>
</BaseLayout>

<script>
  import { initProblemStore, onChange, readAll } from '~/lib/problem-store';
  import { loadProblemLookup } from '~/lib/problem-lookup';

  initProblemStore();

  const grid = document.querySelector<HTMLUListElement>('.co-grid')!;
  const cards = [...grid.querySelectorAll<HTMLLIElement>('.co-card')];
  const search = document.querySelector<HTMLInputElement>('.co-f--search')!;
  const sort = document.querySelector<HTMLSelectElement>('.co-f--sort')!;
  const started = document.querySelector<HTMLInputElement>('.co-f--started')!;
  const countN = document.querySelector<HTMLElement>('.co-count__n')!;
  const empty = document.querySelector<HTMLElement>('.co-empty')!;

  /** Solved counts per company, from local progress + the slug→companies lookup. */
  async function paintSolved(): Promise<void> {
    const solved = Object.entries(readAll()).filter(([, e]) => e.solved).map(([s]) => s);
    const counts = new Map<string, number>();
    // Skip the lookup fetch entirely for visitors with no progress.
    if (solved.length) {
      const lookup = await loadProblemLookup();
      for (const slug of solved) {
        for (const c of lookup?.problems[slug]?.[2] ?? []) counts.set(c, (counts.get(c) ?? 0) + 1);
      }
    }
    for (const card of cards) {
      const n = counts.get(card.dataset.slug!) ?? 0;
      const total = Number(card.dataset.total) || 1;
      card.dataset.solved = String(n);
      card.querySelector<HTMLElement>('.co-solved__n')!.textContent = String(n);
      card.querySelector<HTMLElement>('.co-solved__fill')!.style.width = `${(n / total) * 100}%`;
    }
    apply();
  }

  function apply(): void {
    const needle = search.value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const visible =
        (!needle || card.dataset.name!.includes(needle)) &&
        (!started.checked || Number(card.dataset.solved ?? 0) > 0);
      card.hidden = !visible;
      if (visible) shown++;
    }
    countN.textContent = String(shown);
    empty.hidden = shown > 0;

    const num = (c: HTMLElement, k: string): number => Number(c.dataset[k] ?? 0);
    const sorted = [...cards].sort((a, b) => {
      switch (sort.value) {
        case 'name': return a.dataset.name!.localeCompare(b.dataset.name!);
        case 'recent': return num(b, 'recent') - num(a, 'recent') || num(a, 'order') - num(b, 'order');
        case 'solved': return num(b, 'solved') - num(a, 'solved') || num(a, 'order') - num(b, 'order');
        default: return num(a, 'order') - num(b, 'order');
      }
    });
    grid.append(...sorted);
  }

  search.addEventListener('input', apply);
  sort.addEventListener('input', apply);
  started.addEventListener('input', apply);

  let pending = false;
  onChange(() => {
    // Server sync can emit a burst of changes — repaint once per frame.
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => {
      pending = false;
      void paintSolved();
    });
  });

  void paintSolved();
</script>

<style>
  .crumbs { font-size: 0.82rem; color: var(--fg-faint); margin-bottom: 1rem; }
  .crumbs a { color: var(--fg-muted); }
  .co-head h1 { margin: 0 0 0.5rem; }
  .co-lede { color: var(--fg-muted); max-width: 72ch; line-height: 1.55; margin: 0 0 0.5rem; }
  .co-links { margin: 0.5rem 0 0; font-size: 0.9rem; }

  .co-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin: 1.75rem 0 1rem; }
  .co-f {
    font: inherit;
    font-size: 0.88rem;
    padding: 0.45rem 0.65rem;
    border-radius: 8px;
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    color: var(--fg);
    min-width: 0;
  }
  .co-f--search { flex: 1 1 14rem; }
  .co-f--check { display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; }
  .co-count { margin-left: auto; font-size: 0.8rem; color: var(--fg-faint); font-family: var(--font-code); }

  .co-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0.9rem;
  }
  .co-card__link {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    height: 100%;
    box-sizing: border-box;
    padding: 0.95rem 1.05rem;
    border: 1px solid var(--card-border);
    border-radius: 12px;
    background: var(--card-bg);
    color: var(--fg);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }
  .co-card__link:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, var(--card-bg));
    text-decoration: none;
    transform: translateY(-1px);
  }
  .co-card__name { margin: 0; font-size: 1.05rem; }
  .co-card__meta { margin: 0; font-size: 0.8rem; color: var(--fg-muted); }
  .co-card__recent { color: var(--accent); }
  .co-split { display: flex; height: 6px; border-radius: 999px; overflow: hidden; background: var(--anim-bar-bg); }
  .co-split__e { background: var(--anim-success); }
  .co-split__m { background: var(--anim-highlight); }
  .co-split__h { background: var(--anim-danger); }
  .co-card__legend { margin: 0; font-size: 0.72rem; color: var(--fg-faint); display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; }
  .co-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; margin-left: 0.3rem; }
  .co-dot:first-child { margin-left: 0; }
  .co-dot--e { background: var(--anim-success); }
  .co-dot--m { background: var(--anim-highlight); }
  .co-dot--h { background: var(--anim-danger); }
  .co-solved { display: flex; align-items: center; gap: 0.5rem; margin-top: auto; padding-top: 0.25rem; }
  .co-solved__bar { flex: 1; height: 4px; border-radius: 999px; background: var(--anim-bar-bg); overflow: hidden; }
  .co-solved__fill { display: block; height: 100%; width: 0; background: var(--grad-4); transition: width 0.3s ease; }
  .co-solved__text { font-family: var(--font-code); font-size: 0.7rem; color: var(--fg-faint); white-space: nowrap; }
  .co-card[data-solved]:not([data-solved='0']) .co-solved__text { color: var(--anim-success); }
  .co-empty { color: var(--fg-muted); text-align: center; padding: 2rem 0; }
  .co-foot { margin-top: 2.5rem; font-size: 0.8rem; color: var(--fg-faint); max-width: 72ch; }

  @media (max-width: 480px) {
    .co-grid { grid-template-columns: 1fr 1fr; gap: 0.6rem; }
    .co-card__link { padding: 0.75rem 0.8rem; }
    .co-card__legend { display: none; }
    .co-count { margin-left: 0; }
  }
</style>
