---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CompanyDataCredit from '~/components/CompanyDataCredit.astro';
import ProblemNotesDialog from '~/components/ProblemNotesDialog.astro';
import { COMPANIES_INDEX, COMPANY_FILES, COMPANY_NAMES, PROBLEMS } from '~/lib/company-data';
import type { CompanyFile, CompanySummary } from '~/lib/company-problems';

export function getStaticPaths() {
  return COMPANY_FILES.map((file) => ({
    params: { slug: file.slug },
    props: {
      file,
      summary: COMPANIES_INDEX.companies.find((c) => c.slug === file.slug)!,
    },
  }));
}

interface Props {
  file: CompanyFile;
  summary: CompanySummary;
}

const { file, summary } = Astro.props;

const RECENT_LABEL: Record<string, string> = {
  '30d': 'Reported in the last 30 days',
  '3m': 'Reported in the last 3 months',
  '6m': 'Reported in the last 6 months',
};

// Topic filter options, most common first.
const topicCounts = new Map<string, number>();
for (const p of file.problems) {
  for (const t of p.topics) topicCounts.set(t, (topicCounts.get(t) ?? 0) + 1);
}
const topics = [...topicCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const maxFreq = Math.max(1, ...file.problems.map((p) => p.frequency));

const rows = file.problems.map((p, i) => {
  const all = PROBLEMS[p.slug]?.companies ?? [file.slug];
  const others = all.filter((c) => c !== file.slug);
  return {
    ...p,
    rank: i + 1,
    companySlugs: all,
    othersCount: others.length,
    othersTitle: others.length
      ? `Also asked at: ${others.map((c) => COMPANY_NAMES[c] ?? c).join(', ')}`
      : 'Only on this list',
    freqPct: Math.round((p.frequency / maxFreq) * 100),
  };
});
---
<BaseLayout
  title={`${file.name} DSA interview questions — StackTrace`}
  description={`Top ${summary.problemCount} LeetCode problems asked at ${file.name}, ranked by frequency. Track what you've solved and keep notes.`}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/dsa/">DSA</a> <span aria-hidden="true">/</span>
    <a href="/dsa/companies/">Companies</a> <span aria-hidden="true">/</span>
    <span aria-current="page">{file.name}</span>
  </nav>

  <header class="cq-head">
    <h1>{file.name}</h1>
    <p class="cq-lede">
      Top {summary.problemCount} problems by how often {file.name} asks them
      {summary.sourceCount > summary.problemCount && ` (of ${summary.sourceCount.toLocaleString('en-US')} reported)`}.
      {summary.recent > 0 && ` ${summary.recent} reported in the last six months.`}
      Solve status and notes follow the problem — mark it once, it's ticked on every company list.
    </p>
    <div class="cq-progress" data-total={file.problems.length}>
      <div class="cq-progress__bar" role="progressbar" aria-valuemin="0" aria-valuemax={file.problems.length} aria-valuenow="0" aria-label="Solved">
        <span class="cq-progress__fill"></span>
      </div>
      <span class="cq-progress__text"><strong class="cq-progress__n">0</strong> / {file.problems.length} solved</span>
      <span class="cq-progress__split">
        <span class="diff-pill" data-diff="Easy"><span data-solved-diff="Easy">0</span>/{summary.easy} Easy</span>
        <span class="diff-pill" data-diff="Medium"><span data-solved-diff="Medium">0</span>/{summary.medium} Med</span>
        <span class="diff-pill" data-diff="Hard"><span data-solved-diff="Hard">0</span>/{summary.hard} Hard</span>
      </span>
    </div>
    <CompanyDataCredit />
  </header>

  <section class="cq-filters" aria-label="Filter problems">
    <input class="cq-f cq-f--search" type="search" placeholder="Search titles…" aria-label="Search titles" data-filter="q" />
    <select class="cq-f" aria-label="Difficulty" data-filter="diff">
      <option value="">All difficulties</option>
      <option value="Easy">Easy</option>
      <option value="Medium">Medium</option>
      <option value="Hard">Hard</option>
    </select>
    <select class="cq-f" aria-label="Topic" data-filter="topic">
      <option value="">All topics</option>
      {topics.map(([t, n]) => <option value={t}>{t} ({n})</option>)}
    </select>
    <select class="cq-f" aria-label="Status" data-filter="status">
      <option value="">Solved + unsolved</option>
      <option value="unsolved">Unsolved</option>
      <option value="solved">Solved</option>
      <option value="notes">Has notes</option>
    </select>
    <select class="cq-f" aria-label="Sort by" data-filter="sort">
      <option value="freq">Sort: frequency</option>
      <option value="diff">Sort: difficulty</option>
      <option value="title">Sort: title</option>
      <option value="acc">Sort: acceptance</option>
    </select>
    <label class="cq-f cq-f--check">
      <input type="checkbox" data-filter="recent" /> Recent only
    </label>
    <span class="cq-count" aria-live="polite"><span class="cq-count__n">{rows.length}</span> shown</span>
  </section>

  <div class="cq-scroll">
    <table class="cq-table">
      <thead>
        <tr>
          <th scope="col" class="cq-c-num">#</th>
          <th scope="col">Problem</th>
          <th scope="col">Difficulty</th>
          <th scope="col">Frequency</th>
          <th scope="col">Acceptance</th>
          <th scope="col" class="cq-c-topics">Topics</th>
          <th scope="col" title="Other companies on this site that ask it">Also at</th>
          <th scope="col">Solved</th>
          <th scope="col"><span class="sr-only">Notes</span></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((p) => (
          <tr
            class="cq-row"
            data-slug={p.slug}
            data-rank={p.rank}
            data-title={p.title.toLowerCase()}
            data-diff={p.difficulty}
            data-acc={p.acceptance}
            data-topics={p.topics.join('|')}
            data-recent={p.recent ?? ''}
            data-link={p.link}
            data-companies={p.companySlugs.join(',')}
          >
            <td class="cq-c-num">{p.rank}</td>
            <td class="cq-c-title">
              <a href={p.link} target="_blank" rel="noopener noreferrer">{p.title}</a>
              {p.recent && (
                <span class="cq-recent" title={RECENT_LABEL[p.recent]}>{p.recent}</span>
              )}
            </td>
            <td class="cq-c-diff"><span class="diff-pill" data-diff={p.difficulty}>{p.difficulty}</span></td>
            <td class="cq-c-freq">
              <span class="cq-freq" title={`Frequency ${p.frequency}`}>
                <span class="cq-freq__bar"><span style={`width:${p.freqPct}%`}></span></span>
                <span class="cq-freq__n">{p.frequency}</span>
              </span>
            </td>
            <td class="cq-c-acc"><span class="cq-mlabel">Acc </span>{p.acceptance}%</td>
            <td class="cq-c-topics">
              <ul class="cq-topics">{p.topics.map((t) => <li>{t}</li>)}</ul>
            </td>
            <td class="cq-c-others">
              <button type="button" class="cq-others" title={p.othersTitle} data-open-notes>
                {p.othersCount > 0 ? `+${p.othersCount}` : '—'}
                <span class="cq-mlabel"> {p.othersCount === 1 ? 'company' : 'companies'}</span>
              </button>
            </td>
            <td class="cq-c-solved">
              <label class="cq-solved">
                <input type="checkbox" class="cq-solved__box" aria-label={`Mark ${p.title} solved`} />
                <span class="cq-mlabel">Solved</span>
              </label>
            </td>
            <td class="cq-c-notes">
              <button type="button" class="cq-notes" data-open-notes aria-label={`Notes for ${p.title}`}>
                Notes<span class="cq-notes__dot" aria-hidden="true"></span>
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="cq-empty" hidden>No problems match these filters.</p>
  </div>

  <p class="cq-more">
    <a href="/dsa/my-notes/">My notes &amp; solved problems →</a>
  </p>

  <ProblemNotesDialog />
  <script type="application/json" id="cq-data" set:html={JSON.stringify({ company: file.slug, names: COMPANY_NAMES }).replace(/</g, '\\u003c')} />
</BaseLayout>

<script>
  import { initProblemStore, onChange, readEntry, updateEntry } from '~/lib/problem-store';

  initProblemStore();

  const tbody = document.querySelector<HTMLTableSectionElement>('.cq-table tbody');
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('.cq-row')];
  const bySlug = new Map(rows.map((r) => [r.dataset.slug!, r]));
  const DIFF_ORDER: Record<string, number> = { Easy: 0, Medium: 1, Hard: 2 };
  const page = JSON.parse(document.getElementById('cq-data')?.textContent ?? '{}') as {
    company?: string;
    names: Record<string, string>;
  };
  page.names ??= {};

  const ctl = <T extends HTMLElement>(name: string): T =>
    document.querySelector<T>(`[data-filter="${name}"]`)!;
  const q = ctl<HTMLInputElement>('q');
  const diff = ctl<HTMLSelectElement>('diff');
  const topic = ctl<HTMLSelectElement>('topic');
  const status = ctl<HTMLSelectElement>('status');
  const sort = ctl<HTMLSelectElement>('sort');
  const recent = ctl<HTMLInputElement>('recent');
  const countN = document.querySelector<HTMLElement>('.cq-count__n')!;
  const empty = document.querySelector<HTMLElement>('.cq-empty')!;

  function paintRow(row: HTMLTableRowElement): void {
    const e = readEntry(row.dataset.slug!);
    const solved = e?.solved ?? false;
    row.dataset.solved = solved ? '1' : '0';
    row.dataset.hasNotes = e?.notes.trim() ? '1' : '0';
    row.querySelector<HTMLInputElement>('.cq-solved__box')!.checked = solved;
  }

  function paintProgress(): void {
    const total = rows.length;
    const per: Record<string, number> = { Easy: 0, Medium: 0, Hard: 0 };
    let n = 0;
    for (const r of rows) {
      if (r.dataset.solved !== '1') continue;
      n++;
      per[r.dataset.diff!] = (per[r.dataset.diff!] ?? 0) + 1;
    }
    document.querySelector<HTMLElement>('.cq-progress__n')!.textContent = String(n);
    document.querySelector<HTMLElement>('.cq-progress__fill')!.style.width = `${total ? (n / total) * 100 : 0}%`;
    document.querySelector<HTMLElement>('.cq-progress__bar')!.setAttribute('aria-valuenow', String(n));
    for (const el of document.querySelectorAll<HTMLElement>('[data-solved-diff]')) {
      el.textContent = String(per[el.dataset.solvedDiff!] ?? 0);
    }
  }

  function apply(): void {
    const needle = q.value.trim().toLowerCase();
    let shown = 0;
    for (const r of rows) {
      const d = r.dataset;
      const visible =
        (!needle || d.title!.includes(needle)) &&
        (!diff.value || d.diff === diff.value) &&
        (!topic.value || d.topics!.split('|').includes(topic.value)) &&
        (!recent.checked || d.recent !== '') &&
        (status.value === '' ||
          (status.value === 'solved' && d.solved === '1') ||
          (status.value === 'unsolved' && d.solved !== '1') ||
          (status.value === 'notes' && d.hasNotes === '1'));
      r.hidden = !visible;
      if (visible) shown++;
    }
    countN.textContent = String(shown);
    empty.hidden = shown > 0;
  }

  function applySort(): void {
    const key = sort.value;
    const rank = (r: HTMLTableRowElement): number => Number(r.dataset.rank);
    const sorted = [...rows].sort((a, b) => {
      if (key === 'diff') return DIFF_ORDER[a.dataset.diff!]! - DIFF_ORDER[b.dataset.diff!]! || rank(a) - rank(b);
      if (key === 'title') return a.dataset.title!.localeCompare(b.dataset.title!);
      if (key === 'acc') return Number(b.dataset.acc) - Number(a.dataset.acc) || rank(a) - rank(b);
      return rank(a) - rank(b);
    });
    tbody?.append(...sorted);
  }

  for (const r of rows) paintRow(r);
  paintProgress();
  apply();

  for (const el of [q, diff, topic, status, recent]) el.addEventListener('input', apply);
  sort.addEventListener('input', applySort);

  tbody?.addEventListener('change', (e) => {
    const box = e.target as HTMLElement;
    if (!box.classList.contains('cq-solved__box')) return;
    const row = box.closest<HTMLTableRowElement>('.cq-row');
    if (row) updateEntry(row.dataset.slug!, { solved: (box as HTMLInputElement).checked });
  });

  tbody?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-open-notes]');
    if (!btn) return;
    const row = btn.closest<HTMLTableRowElement>('.cq-row');
    if (!row) return;
    const d = row.dataset;
    window.dispatchEvent(
      new CustomEvent('stacktrace:open-notes', {
        detail: {
          slug: d.slug,
          title: row.querySelector('.cq-c-title a')?.textContent ?? d.slug,
          link: d.link,
          difficulty: d.diff,
          companies: (d.companies ?? '').split(',').filter(Boolean).map((c) => ({ slug: c, name: page.names[c] ?? c })),
          currentCompany: page.company,
        },
      }),
    );
  });

  // Any change — this page, the Notes panel, another tab, or server sync.
  onChange((d) => {
    const row = bySlug.get(d.slug);
    if (!row) return;
    paintRow(row);
    paintProgress();
    // Keep the row visible right after a local click even if a status filter
    // would now hide it; re-filter on the next filter interaction.
    if (d.source !== 'local') apply();
  });
</script>

<style>
  .crumbs { font-size: 0.82rem; color: var(--fg-faint); margin-bottom: 1rem; }
  .crumbs a { color: var(--fg-muted); }
  .cq-head { margin-bottom: 1.5rem; }
  .cq-head h1 { margin: 0 0 0.4rem; }
  .cq-lede { color: var(--fg-muted); max-width: 72ch; line-height: 1.55; margin: 0 0 1rem; }

  .cq-progress { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  .cq-progress__bar {
    flex: 1 1 14rem;
    height: 10px;
    border-radius: 999px;
    background: var(--anim-bar-bg);
    overflow: hidden;
  }
  .cq-progress__fill { display: block; height: 100%; width: 0; background: var(--grad-4); transition: width 0.3s ease; }
  .cq-progress__text { font-size: 0.9rem; color: var(--fg-muted); }
  .cq-progress__text strong { color: var(--fg); }
  .cq-progress__split { display: flex; gap: 0.35rem; flex-wrap: wrap; }

  .cq-filters {
    position: sticky;
    top: 56px;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    padding: 0.6rem 0;
    margin-bottom: 0.5rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }
  .cq-f {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    color: var(--fg);
    min-width: 0;
  }
  .cq-f--search { flex: 1 1 12rem; }
  .cq-f--check { display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; }
  .cq-count { margin-left: auto; font-size: 0.8rem; color: var(--fg-faint); font-family: var(--font-code); }

  .cq-scroll { overflow-x: auto; }
  .cq-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .cq-table th {
    text-align: left;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-faint);
    font-weight: 600;
    padding: 0.5rem 0.55rem;
    border-bottom: 1px solid var(--card-border);
    white-space: nowrap;
  }
  .cq-table td { padding: 0.55rem; border-bottom: 1px solid color-mix(in srgb, var(--card-border) 55%, transparent); vertical-align: middle; }
  .cq-row:hover td { background: color-mix(in srgb, var(--accent) 4%, transparent); }
  .cq-row[data-solved='1'] .cq-c-title a { color: var(--fg-muted); }
  .cq-row[data-solved='1'] .cq-c-num { color: var(--anim-success); }
  .cq-c-num { font-family: var(--font-code); color: var(--fg-faint); font-size: 0.78rem; width: 2.5rem; }
  .cq-c-title a { color: var(--fg); font-weight: 500; }
  .cq-recent {
    margin-left: 0.4rem;
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    font-family: var(--font-code);
    font-size: 0.65rem;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    vertical-align: 1px;
    cursor: help;
  }
  .cq-freq { display: inline-flex; align-items: center; gap: 0.4rem; }
  .cq-freq__bar { width: 4.5rem; height: 6px; border-radius: 999px; background: var(--anim-bar-bg); overflow: hidden; }
  .cq-freq__bar span { display: block; height: 100%; background: var(--grad-6); }
  .cq-freq__n { font-family: var(--font-code); font-size: 0.75rem; color: var(--fg-muted); min-width: 2.2rem; }
  .cq-c-acc { font-family: var(--font-code); font-size: 0.78rem; color: var(--fg-muted); white-space: nowrap; }
  .cq-topics { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem; max-width: 22rem; }
  .cq-topics li {
    font-size: 0.68rem;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .cq-others, .cq-notes {
    font: inherit;
    font-size: 0.8rem;
    padding: 0.25rem 0.55rem;
    border-radius: 7px;
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    color: var(--fg-muted);
    cursor: pointer;
    white-space: nowrap;
  }
  .cq-others { font-family: var(--font-code); border-style: dashed; }
  .cq-others:hover, .cq-notes:hover { color: var(--fg); border-color: var(--accent); }
  .cq-notes { position: relative; }
  .cq-notes__dot {
    display: none;
    position: absolute;
    top: -3px;
    right: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .cq-row[data-has-notes='1'] .cq-notes__dot { display: block; }
  .cq-row[data-has-notes='1'] .cq-notes { color: var(--fg); }
  .cq-solved { display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; }
  .cq-solved__box { width: 1.05rem; height: 1.05rem; accent-color: var(--anim-success); cursor: pointer; }
  .cq-mlabel { display: none; }
  .cq-empty { color: var(--fg-muted); text-align: center; padding: 2rem 0; }
  .cq-more { margin-top: 2rem; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* Phone: each row becomes a compact card. */
  @media (max-width: 760px) {
    .cq-filters { top: 0; position: static; }
    .cq-f { flex: 1 1 calc(50% - 0.5rem); }
    .cq-f--search { flex-basis: 100%; }
    .cq-count { margin-left: 0; }
    .cq-table thead { display: none; }
    .cq-table, .cq-table tbody { display: block; }
    .cq-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'num title title'
        'diff freq acc'
        'topics topics topics'
        'solved others notes';
      gap: 0.45rem 0.6rem;
      padding: 0.8rem 0.25rem;
      border-bottom: 1px solid color-mix(in srgb, var(--card-border) 55%, transparent);
    }
    .cq-row[hidden] { display: none; }
    .cq-table td { padding: 0; border: 0; }
    .cq-row:hover td { background: none; }
    .cq-c-num { grid-area: num; width: auto; }
    .cq-c-title { grid-area: title; }
    .cq-c-diff { grid-area: diff; }
    .cq-c-freq { grid-area: freq; }
    .cq-c-acc { grid-area: acc; text-align: right; }
    .cq-c-topics { grid-area: topics; }
    .cq-c-solved { grid-area: solved; }
    .cq-c-others { grid-area: others; justify-self: end; }
    .cq-c-notes { grid-area: notes; justify-self: end; }
    .cq-mlabel { display: inline; }
    .cq-c-acc .cq-mlabel { color: var(--fg-faint); }
    .cq-freq__bar { width: 3.5rem; }
  }
</style>
