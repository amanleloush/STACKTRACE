---
// Printable revision sheet for one system-design phase. Prerendered.
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import RevisePhase from '~/components/revise/RevisePhase.astro';
import { byOrder, neighbours, noteTopic } from '~/components/revise/revise-data';
import { NOTES_PHASES, type NotesPhase } from '~/lib/notes-phases';

export async function getStaticPaths() {
  return NOTES_PHASES.map((p) => ({ params: { phase: p.slug }, props: { phase: p } }));
}

interface Props {
  phase: NotesPhase;
}

const { phase } = Astro.props;
const entries = (
  await getCollection('notes', (n) => !n.data.draft && n.data.phase === phase.slug)
).sort(byOrder);
const topics = entries.map(noteTopic);
const { prev, next } = neighbours(NOTES_PHASES, phase.slug);
---
<BaseLayout
  title={`Revise ${phase.title} · System Design — StackTrace`}
  description={`Every one-liner, definition and cheat sheet for ${phase.title}, on one printable page.`}
>
  <RevisePhase kind="notes" phase={phase} topics={topics} prev={prev} next={next} />
</BaseLayout>
