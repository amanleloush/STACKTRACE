---
// Printable revision sheet for one DSA pattern phase. Prerendered.
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import RevisePhase from '~/components/revise/RevisePhase.astro';
import { byOrder, dsaTopic, neighbours } from '~/components/revise/revise-data';
import { PHASES, type DsaPhase } from '~/lib/dsa-phases';

export async function getStaticPaths() {
  return PHASES.map((p) => ({ params: { phase: p.slug }, props: { phase: p } }));
}

interface Props {
  phase: DsaPhase;
}

const { phase } = Astro.props;
const entries = (
  await getCollection('dsa', (n) => !n.data.draft && n.data.phase === phase.slug)
).sort(byOrder);
const topics = entries.map(dsaTopic);
const { prev, next } = neighbours(PHASES, phase.slug);
---
<BaseLayout
  title={`Revise ${phase.title} · DSA — StackTrace`}
  description={`Every one-liner, explanation, complexity and pitfall for ${phase.title}, on one printable page.`}
>
  <RevisePhase kind="dsa" phase={phase} topics={topics} prev={prev} next={next} />
</BaseLayout>
