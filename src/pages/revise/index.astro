---
// Revision hub: one card per notes phase and per DSA phase, each linking
// to its printable one-page revision sheet. Prerendered.
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { NOTES_PHASES } from '~/lib/notes-phases';
import { PHASES as DSA_PHASES } from '~/lib/dsa-phases';

const [notes, dsa] = await Promise.all([
  getCollection('notes', (n) => !n.data.draft),
  getCollection('dsa', (n) => !n.data.draft),
]);

const countBy = (items: { data: { phase: string } }[]): Map<string, number> => {
  const m = new Map<string, number>();
  for (const it of items) m.set(it.data.phase, (m.get(it.data.phase) ?? 0) + 1);
  return m;
};
const noteCounts = countBy(notes);
const dsaCounts = countBy(dsa);

const groups = [
  {
    id: 'rv-hub-notes',
    label: 'System design',
    base: '/revise/notes/',
    noun: 'note',
    phases: NOTES_PHASES,
    counts: noteCounts,
    total: notes.length,
  },
  {
    id: 'rv-hub-dsa',
    label: 'DSA patterns',
    base: '/revise/dsa/',
    noun: 'problem',
    phases: DSA_PHASES,
    counts: dsaCounts,
    total: dsa.length,
  },
];

// Every sheet URL, for the "Save for offline" button (public/sw.js caches them).
const sheetUrls = groups.flatMap((g) => g.phases.map((p) => `${g.base}${p.slug}/`));
---
<BaseLayout
  title="Revision mode — StackTrace"
  description="Every one-liner and cheat sheet, one printable page per phase. Print it or save it as PDF."
>
  <header class="hub-head">
    <h1>Revision mode</h1>
    <p class="hub-lede">
      Everything you need the night before: every one-liner and cheat sheet, in one page per
      phase. Print it or save it as PDF.
    </p>
    <p class="hub-hint">
      Each sheet has a “One-liners only” switch for rapid-fire recall, and prints black on white
      with every section expanded.
    </p>
    <p class="hub-hint">
      Quiz questions you got wrong are saved in your
      <a href="/review/mistakes/">mistakes notebook</a>. Ready to test yourself? Try a
      <a href="/mock/">timed mock round</a>. Everything you highlighted is in
      <a href="/highlights/">My highlights</a>.
    </p>
    <!-- Revealed by the script below only when a service worker can run. -->
    <div class="hub-offline" id="hub-offline" data-urls={JSON.stringify(sheetUrls)} hidden>
      <button type="button" class="hub-offline__btn" id="hub-offline-btn">
        Save all revision sheets for offline
      </button>
      <progress class="hub-offline__bar" id="hub-offline-bar" max={sheetUrls.length} value="0" hidden></progress>
      <p class="hub-offline__status" id="hub-offline-status" aria-live="polite"></p>
    </div>
  </header>

  {groups.map((g) => (
    <section class="hub-group" aria-labelledby={g.id}>
      <h2 class="hub-group__title" id={g.id}>
        {g.label} <span class="hub-group__count">{g.total} topics</span>
      </h2>
      <ul class="hub-grid">
        {g.phases.map((p) => {
          const count = g.counts.get(p.slug) ?? 0;
          return (
            <li>
              <a class="hub-card" href={`${g.base}${p.slug}/`} data-empty={count === 0 ? 'true' : undefined}>
                <span class="hub-card__num">{p.num}</span>
                <span class="hub-card__title">{p.title}</span>
                <span class="hub-card__blurb">{p.blurb}</span>
                <span class="hub-card__count">
                  {count === 0 ? 'Coming soon' : `${count} ${g.noun}${count === 1 ? '' : 's'}`}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</BaseLayout>

<script>
  // "Save all for offline": asks the service worker (public/sw.js, message
  // CACHE_URLS) to fetch and cache every sheet plus its CSS/JS, and shows
  // progress. Cache Storage is read directly to say how many are saved.
  const box = document.getElementById('hub-offline');
  const btn = document.getElementById('hub-offline-btn') as HTMLButtonElement | null;
  const bar = document.getElementById('hub-offline-bar') as HTMLProgressElement | null;
  const statusEl = document.getElementById('hub-offline-status');

  let urls: string[] = [];
  try {
    const parsed: unknown = JSON.parse(box?.dataset.urls ?? '[]');
    if (Array.isArray(parsed)) urls = parsed.filter((u): u is string => typeof u === 'string');
  } catch {
    urls = [];
  }

  const say = (t: string): void => {
    if (statusEl) statusEl.textContent = t;
  };

  async function countSaved(): Promise<number> {
    let n = 0;
    try {
      for (const u of urls) if (await caches.match(new URL(u, location.origin).href)) n += 1;
    } catch {
      return 0;
    }
    return n;
  }

  /** The active worker, waiting at most a few seconds for a first install. */
  async function activeWorker(): Promise<ServiceWorker | null> {
    const timeout = new Promise<null>((r) => setTimeout(() => r(null), 8000));
    const ready = navigator.serviceWorker.ready.then((reg) => reg.active).catch(() => null);
    return Promise.race([ready, timeout]);
  }

  async function saveAll(): Promise<void> {
    if (!btn || !bar) return;
    btn.disabled = true;
    say('Preparing…');
    const worker = await activeWorker();
    if (!worker) {
      say('Offline saving is not available in this browser right now. Reload the page and try again.');
      btn.disabled = false;
      return;
    }
    bar.hidden = false;
    bar.max = urls.length;
    bar.value = 0;
    const channel = new MessageChannel();
    channel.port1.onmessage = (ev: MessageEvent) => {
      const d = ev.data as { type?: string; done?: number; failed?: number; total?: number };
      const done = Number(d.done) || 0;
      const failed = Number(d.failed) || 0;
      const total = Number(d.total) || urls.length;
      bar.value = done;
      if (d.type === 'done') {
        btn.disabled = false;
        btn.textContent = 'Update offline copies';
        say(
          failed === 0
            ? `All ${total} revision sheets are saved on this device.`
            : `Saved ${total - failed} of ${total} sheets. ${failed} failed; check your connection and try again.`,
        );
        channel.port1.close();
      } else {
        say(`Saving ${done} of ${total}…`);
      }
    };
    worker.postMessage({ type: 'CACHE_URLS', urls }, [channel.port2]);
  }

  if (box && btn && 'serviceWorker' in navigator && 'caches' in window && urls.length > 0) {
    box.hidden = false;
    btn.addEventListener('click', () => void saveAll());
    void countSaved().then((n) => {
      if (n === urls.length) {
        btn.textContent = 'Update offline copies';
        say(`All ${n} revision sheets are saved on this device.`);
      } else if (n > 0) {
        say(`${n} of ${urls.length} revision sheets are saved on this device.`);
      }
    });
  }
</script>

<style>
  .hub-offline {
    margin: 1.2rem auto 0;
    max-width: 60ch;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .hub-offline__btn {
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--fg);
    cursor: pointer;
  }
  .hub-offline__btn:hover:not(:disabled) { background: color-mix(in srgb, var(--accent) 22%, transparent); }
  .hub-offline__btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .hub-offline__btn:disabled { opacity: 0.6; cursor: progress; }
  .hub-offline[hidden],
  .hub-offline__bar[hidden] { display: none; }
  .hub-offline__bar { width: min(320px, 100%); accent-color: var(--accent); }
  .hub-offline__status { margin: 0; min-height: 1.2em; color: var(--fg-muted); font-size: 0.85rem; }

  .hub-head { margin-bottom: 2.25rem; text-align: center; }
  .hub-head h1 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 800;
    background: var(--grad-3);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hub-lede { color: var(--fg); margin: 0.6rem auto 0; max-width: 60ch; line-height: 1.5; }
  .hub-hint { color: var(--fg-muted); font-size: 0.88rem; margin: 0.5rem auto 0; max-width: 60ch; }

  .hub-group { margin-bottom: 2.5rem; }
  .hub-group__title {
    font-size: 1.2rem;
    margin: 0 0 0.9rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .hub-group__count {
    font-family: var(--font-code);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--fg-muted);
  }

  .hub-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 1rem;
  }
  .hub-grid li { margin: 0; display: flex; }
  .hub-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--card-border);
    border-radius: 12px;
    background: var(--card-bg);
    color: var(--fg);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }
  .hub-card:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, var(--card-bg));
    text-decoration: none;
    transform: translateY(-1px);
  }
  .hub-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .hub-card[data-empty='true'] { opacity: 0.78; }
  .hub-card__num {
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--fg-faint);
    letter-spacing: 0.06em;
  }
  .hub-card__title {
    font-size: 1.05rem;
    font-weight: 700;
    background: var(--grad-3);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hub-card__blurb { font-size: 0.85rem; color: var(--fg-muted); line-height: 1.4; flex: 1; }
  .hub-card__count {
    margin-top: 0.4rem;
    font-family: var(--font-code);
    font-size: 0.7rem;
    color: var(--fg-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
